# .env.example
# Configuration pour le frontend (React/Astro)

# URL de l'API Gateway (récupérée après déploiement Terraform)
PUBLIC_API_GATEWAY_URL=https://abc123.execute-api.eu-west-1.amazonaws.com/prod/contact

# Configuration optionnelle pour les tests
PUBLIC_TEST_MODE=false

# Configuration pour les analytics (optionnel)
PUBLIC_GOOGLE_ANALYTICS_ID=

# Configuration pour les environnements
PUBLIC_ENVIRONMENT=production

# Variables pour le développement local
VITE_API_URL=http://localhost:3001/dev/contact
REACT_APP_API_GATEWAY_URL=https://abc123.execute-api.eu-west-1.amazonaws.com/prod/contact